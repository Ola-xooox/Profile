---
// Web5InspectorDrawer.astro - White Background Web5 Inspection Drawer Panel
import { profileData } from '../data/profile';
---

<div 
  id="web5-inspector-modal" 
  class="fixed inset-0 z-50 invisible opacity-0 transition-all duration-300 pointer-events-none flex items-center justify-center p-4 sm:p-6"
>
  <!-- Backdrop Blur -->
  <div id="web5-inspector-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-md"></div>

  <!-- Modal Container -->
  <div class="relative w-full max-w-3xl max-h-[90vh] bg-white border border-neutral-300 rounded-2xl shadow-2xl flex flex-col overflow-hidden pointer-events-auto transform scale-95 transition-transform duration-300 text-black">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-200 bg-neutral-50">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-black text-white">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-mono text-base font-bold text-black flex items-center gap-2">
            Identity & Skill Verification
          </h3>
          <p class="text-xs text-neutral-600 font-mono">
            Verified Developer Credentials & Security Proofs
          </p>
        </div>
      </div>

      <button 
        id="close-web5-drawer-btn" 
        class="p-2 text-neutral-500 hover:text-black rounded-lg hover:bg-neutral-200 transition-colors"
        aria-label="Close modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Modal Tab Bar -->
    <div class="flex border-b border-neutral-200 bg-neutral-50 font-mono text-xs">
      <button 
        data-drawer-tab="vcs" 
        class="drawer-tab-btn active px-6 py-3 border-b-2 border-black text-black font-bold bg-white transition-all"
      >
        Verified Skills ({profileData.verifiableCredentials.length})
      </button>
      <button 
        data-drawer-tab="raw-did" 
        class="drawer-tab-btn px-6 py-3 border-b-2 border-transparent text-neutral-600 hover:text-black transition-all"
      >
        Developer Data (JSON)
      </button>
      <button 
        data-drawer-tab="proofs" 
        class="drawer-tab-btn px-6 py-3 border-b-2 border-transparent text-neutral-600 hover:text-black transition-all"
      >
        Security Status
      </button>
    </div>

    <!-- Modal Content Panel -->
    <div class="p-6 overflow-y-auto space-y-6 flex-1 font-mono text-xs bg-white">
      <!-- Tab 1: Verifiable Credentials List -->
      <div id="drawer-tab-content-vcs" class="space-y-4">
        {profileData.verifiableCredentials.map((vc) => (
          <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-200 space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded bg-black text-white text-[11px] font-bold">
                {vc.type}
              </span>
              <span class="text-neutral-500 text-[11px] font-bold">Issued: {vc.issuanceDate.split('T')[0]}</span>
            </div>
            <div class="text-neutral-800">
              <span class="text-neutral-500 font-bold">Issuer:</span> <span class="text-black font-bold">{vc.issuer}</span>
            </div>
            <div class="p-3 rounded bg-white border border-neutral-300 text-black font-semibold">
              <span class="text-black font-extrabold">Skill:</span> "{vc.credentialSubject.claim}"
            </div>
            <div class="flex items-center justify-between text-[10px] text-neutral-600 bg-neutral-100 px-3 py-1.5 rounded font-bold">
              <span>Proof ID: {vc.credentialSubject.proofHash.substring(0, 16)}...</span>
              <span class="text-black font-extrabold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-black"></span>
                Verified
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Tab 2: Raw JSON-LD Schema -->
      <div id="drawer-tab-content-raw-did" class="hidden">
        <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-300 text-black font-mono text-[11px] overflow-x-auto leading-relaxed font-semibold">
          <pre class="text-black">{JSON.stringify({
            "@context": [
              "https://www.w3.org/2018/credentials/v1",
              "https://identity.foundation/schemas/dwn-v1.json"
            ],
            id: profileData.did,
            dwnEndpoint: profileData.dwnEndpoint,
            developer: profileData.developer,
            skillCategoriesCount: Object.keys(profileData.skills).length,
            projectsCount: profileData.projects.length,
            verificationStatus: "Verified"
          }, null, 2)}</pre>
        </div>
      </div>

      <!-- Tab 3: Cryptographic Proof Status -->
      <div id="drawer-tab-content-proofs" class="hidden space-y-4">
        <div class="p-4 rounded-xl bg-neutral-50 border border-neutral-300 space-y-3">
          <h4 class="text-sm font-black text-black mb-2">Security & Verification Key Status</h4>
          <div class="grid grid-cols-2 gap-3 text-[11px]">
            <div class="p-2 rounded bg-white border border-neutral-200">
              <span class="text-neutral-500 font-bold">Algorithm:</span>
              <span class="text-black font-extrabold block mt-1">Ed25519-2026</span>
            </div>
            <div class="p-2 rounded bg-white border border-neutral-200">
              <span class="text-neutral-500 font-bold">Challenge ID:</span>
              <span class="text-black font-bold block mt-1">0x9f38a102c89</span>
            </div>
            <div class="p-2 rounded bg-white border border-neutral-200">
              <span class="text-neutral-500 font-bold">Hash Key:</span>
              <span class="text-black font-bold block mt-1">0xa4b19c83f120e</span>
            </div>
            <div class="p-2 rounded bg-white border border-neutral-200">
              <span class="text-neutral-500 font-bold">Node Status:</span>
              <span class="text-black font-black block mt-1">Online & Synchronized</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-6 py-3 border-t border-neutral-200 bg-neutral-50 flex items-center justify-between text-xs font-mono">
      <span class="text-neutral-600">
        Status: <span class="text-black font-extrabold">Active</span>
      </span>
      <button 
        id="close-web5-drawer-footer-btn"
        class="px-4 py-1.5 rounded-lg bg-black text-white hover:bg-neutral-800 font-bold border border-black transition-all"
      >
        Close
      </button>
    </div>
  </div>
</div>

<script>
  function setupWeb5Drawer() {
    const modal = document.getElementById('web5-inspector-modal');
    const openBtn = document.getElementById('open-web5-drawer-btn');
    const closeBtn = document.getElementById('close-web5-drawer-btn');
    const closeFooterBtn = document.getElementById('close-web5-drawer-footer-btn');
    const backdrop = document.getElementById('web5-inspector-backdrop');
    const projectInspectBtns = document.querySelectorAll('[data-inspect-project-id]');

    function openModal() {
      if (!modal) return;
      modal.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
      const container = modal.querySelector('.relative');
      if (container) {
        container.classList.remove('scale-95');
        container.classList.add('scale-100');
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      const container = modal.querySelector('.relative');
      if (container) {
        container.classList.remove('scale-100');
        container.classList.add('scale-95');
      }
      setTimeout(() => {
        modal.classList.add('invisible');
      }, 300);
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeFooterBtn) closeFooterBtn.addEventListener('click', closeModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);

    projectInspectBtns.forEach(btn => {
      btn.addEventListener('click', openModal);
    });

    // Modal Tabs logic
    const tabBtns = document.querySelectorAll('.drawer-tab-btn');
    const tabContents = {
      'vcs': document.getElementById('drawer-tab-content-vcs'),
      'raw-did': document.getElementById('drawer-tab-content-raw-did'),
      'proofs': document.getElementById('drawer-tab-content-proofs'),
    };

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-drawer-tab');
        if (!targetTab) return;

        tabBtns.forEach(b => {
          b.classList.remove('border-black', 'text-black', 'font-bold', 'bg-white');
          b.classList.add('border-transparent', 'text-neutral-600');
        });
        btn.classList.add('border-black', 'text-black', 'font-bold', 'bg-white');
        btn.classList.remove('border-transparent', 'text-neutral-600');

        Object.keys(tabContents).forEach(key => {
          const contentEl = tabContents[key as keyof typeof tabContents];
          if (contentEl) {
            if (key === targetTab) {
              contentEl.classList.remove('hidden');
            } else {
              contentEl.classList.add('hidden');
            }
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWeb5Drawer);
  } else {
    setupWeb5Drawer();
  }
</script>
