---
// ProjectCard.astro - White Background Cyber Project Card
import type { ProjectItem } from '../data/profile';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<div class="glass-panel-interactive rounded-xl p-6 flex flex-col justify-between h-full border border-neutral-300 bg-white/90 shadow-md group">
  <div>
    <!-- Header: Project ID Badge & Schema Tag -->
    <div class="flex items-center justify-between mb-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-black text-white shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
        {project.id}
      </span>
      {project.schemaVersion && (
        <span class="text-[10px] font-mono text-neutral-600 bg-neutral-100 px-2 py-0.5 rounded border border-neutral-300 font-semibold">
          MANIFEST: {project.schemaVersion}
        </span>
      )}
    </div>

    <!-- Title & Description -->
    <h3 class="text-xl font-black text-black mb-2 group-hover:text-neutral-700 transition-colors flex items-center gap-2">
      {project.title}
    </h3>
    <p class="text-neutral-700 text-sm leading-relaxed mb-5 font-normal">
      {project.description}
    </p>

    <!-- Key Architecture Section -->
    {project.architecture && project.architecture.length > 0 && (
      <div class="mb-5 space-y-2">
        <h4 class="text-xs font-mono uppercase tracking-wider text-neutral-500 font-bold mb-2">
          // Key Architecture
        </h4>
        {project.architecture.map((item) => (
          <div class="flex items-start gap-2 text-xs text-neutral-800 font-medium">
            <svg class="w-4 h-4 text-black mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Deliverables Section -->
    {project.deliverables && project.deliverables.length > 0 && (
      <div class="mb-6 space-y-2">
        <h4 class="text-xs font-mono uppercase tracking-wider text-neutral-500 font-bold mb-2">
          // Deliverables
        </h4>
        {project.deliverables.map((item) => (
          <div class="flex items-start gap-2 text-xs text-neutral-800 font-medium">
            <svg class="w-4 h-4 text-black mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Highlights Section (Fallback) -->
    {project.highlights && project.highlights.length > 0 && !project.architecture && !project.deliverables && (
      <div class="mb-6 space-y-2">
        <h4 class="text-xs font-mono uppercase tracking-wider text-neutral-500 font-bold mb-2">
          // Key Contributions
        </h4>
        {project.highlights.map((highlight) => (
          <div class="flex items-start gap-2 text-xs text-neutral-800 font-medium">
            <svg class="w-4 h-4 text-black mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span>{highlight}</span>
          </div>
        ))}
      </div>
    )}
  </div>

  <div>
    <!-- Tech Stack Tags -->
    <div class="flex flex-wrap gap-1.5 mb-6 pt-4 border-t border-neutral-200">
      {project.tags.map((tag) => (
        <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-neutral-100 text-black border border-neutral-300 font-bold group-hover:border-black transition-colors">
          #{tag}
        </span>
      ))}
    </div>

    <!-- Action Buttons / Links -->
    <div class="flex items-center justify-between gap-3">
      {project.demoUrl && (
        <a 
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-xs font-mono font-bold text-white bg-black hover:bg-neutral-800 shadow-md transition-all active:scale-95"
        >
          <span>LIVE PREVIEW</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      )}

      <button
        type="button"
        data-inspect-project-id={project.id}
        class="inline-flex items-center justify-center p-2.5 rounded-lg bg-neutral-100 text-black hover:bg-neutral-200 border border-neutral-300 hover:border-black transition-all"
        title="Inspect Web5 Schema Record"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </button>
    </div>
  </div>
</div>
