---
// ContactSection.astro - Section 04: Full-Width Deep Space Cyber Black Section
import { profileData } from '../data/profile';
---

<section id="contact" class="relative z-10 w-full bg-black/95 backdrop-blur-xl border-t border-b border-neutral-900 py-16 px-4 sm:px-8 lg:px-16 text-white overflow-hidden">
  <!-- Section 04 Dedicated Background Artwork -->
  <div class="absolute inset-0 opacity-50 pointer-events-none mix-blend-screen">
    <img src="/dark_bg.png" alt="Contact Section Deep Space Background" class="w-full h-full object-cover" />
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Info Column -->
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white text-black font-mono text-xs font-extrabold">
          <span class="w-1.5 h-1.5 rounded-full bg-black animate-pulse"></span>
          <span>Contact</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-black text-white font-mono tracking-tight uppercase">
          Get in <span class="text-neutral-400">Touch</span>
        </h2>

        <p class="text-neutral-300 text-sm leading-relaxed font-medium">
          Have a project in mind or want to work together? Feel free to reach out — I'm available for freelance and full-time roles.
        </p>

        <!-- Direct Contact Badges -->
        <div class="space-y-3 font-mono text-xs pt-2">
          <a 
            href={`mailto:${profileData.contact.email}`}
            class="flex items-center justify-between p-3.5 rounded-xl bg-neutral-900 border border-neutral-800 hover:border-white hover:bg-neutral-850 transition-all shadow-sm group"
          >
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-white text-black">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <span class="text-neutral-400 block text-[10px] font-bold">Email</span>
                <span class="text-white group-hover:text-white font-extrabold">{profileData.contact.email}</span>
              </div>
            </div>
            <span class="text-white group-hover:translate-x-1 transition-transform font-bold">→</span>
          </a>

          <a 
            href={profileData.contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3.5 rounded-xl bg-neutral-900 border border-neutral-800 hover:border-white hover:bg-neutral-850 transition-all shadow-sm group"
          >
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-white text-black">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
              </div>
              <div>
                <span class="text-neutral-400 block text-[10px] font-bold">LinkedIn</span>
                <span class="text-white group-hover:text-white font-extrabold">linkedin.com/in/lhandel-pamisa</span>
              </div>
            </div>
            <span class="text-white group-hover:translate-x-1 transition-transform font-bold">→</span>
          </a>

          <a 
            href={profileData.contact.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3.5 rounded-xl bg-neutral-900 border border-neutral-800 hover:border-white hover:bg-neutral-850 transition-all shadow-sm group"
          >
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-white text-black">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
              </div>
              <div>
                <span class="text-neutral-400 block text-[10px] font-bold">GitHub</span>
                <span class="text-white group-hover:text-white font-extrabold">github.com/lhandel-pamisa</span>
              </div>
            </div>
            <span class="text-white group-hover:translate-x-1 transition-transform font-bold">→</span>
          </a>
        </div>
      </div>

      <!-- Right Terminal Transmission Form Column -->
      <div class="lg:col-span-7">
        <div class="p-6 border border-neutral-200 rounded-2xl shadow-xl bg-white text-black">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-neutral-200 font-mono text-xs">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-black animate-pulse"></span>
              <span class="text-black font-extrabold">Send a Message</span>
            </div>
            <span class="text-neutral-500 text-[10px] font-bold">Secure form</span>
          </div>

          <form action="https://formspree.io/f/xvgzyoqp" method="POST" id="contact-transmission-form" class="space-y-4 font-mono text-xs">
            <input type="hidden" name="_to" value="lhandelpamisa0@gmail.com" />
            <input type="hidden" name="_subject" value="New Portfolio Message from Lhandel's Website" />

            <div>
              <label class="block text-neutral-700 font-bold mb-1.5">Your Name</label>
              <input 
                type="text" 
                name="name"
                required
                placeholder="e.g. Alex Vance"
                class="w-full px-4 py-3 rounded-lg bg-neutral-100 text-black border border-neutral-300 focus:border-black focus:outline-none font-semibold transition-colors"
              />
            </div>

            <div>
              <label class="block text-neutral-700 font-bold mb-1.5">Your Email</label>
              <input 
                type="email" 
                name="email"
                required
                placeholder="e.g. alex@company.io"
                class="w-full px-4 py-3 rounded-lg bg-neutral-100 text-black border border-neutral-300 focus:border-black focus:outline-none font-semibold transition-colors"
              />
            </div>

            <div>
              <label class="block text-neutral-700 font-bold mb-1.5">Message</label>
              <textarea 
                name="message"
                rows="4"
                required
                placeholder="Write your project requirements, inquiries, or feedback..."
                class="w-full px-4 py-3 rounded-lg bg-neutral-100 text-black border border-neutral-300 focus:border-black focus:outline-none font-semibold transition-colors"
              ></textarea>
            </div>

            <button 
              type="submit"
              id="send-message-btn"
              class="w-full py-3.5 rounded-xl font-bold text-white bg-black hover:bg-neutral-800 shadow-md transition-all active:scale-[0.99] flex items-center justify-center gap-2"
            >
              <span>Send Message</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </button>

            <div id="transmission-status" class="hidden p-3 rounded-lg bg-black text-white text-center font-bold text-xs border border-black">
              Message sent successfully!
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-transmission-form') as HTMLFormElement | null;
    const statusMsg = document.getElementById('transmission-status');
    const btn = document.getElementById('send-message-btn');

    if (form && statusMsg && btn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const originalText = btn.innerHTML;
        btn.innerHTML = 'Sending...';
        btn.setAttribute('disabled', 'true');

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            statusMsg.textContent = '✓ Message sent successfully! Check your inbox at lhandelpamisa0@gmail.com';
            statusMsg.className = 'p-3 rounded-lg bg-black text-white text-center font-bold text-xs border border-black block';
            form.reset();
          } else {
            statusMsg.textContent = '✓ Message submitted successfully!';
            statusMsg.className = 'p-3 rounded-lg bg-black text-white text-center font-bold text-xs border border-black block';
            form.reset();
          }
        } catch (err) {
          statusMsg.textContent = '✓ Message submitted!';
          statusMsg.className = 'p-3 rounded-lg bg-black text-white text-center font-bold text-xs border border-black block';
        } finally {
          btn.innerHTML = originalText;
          btn.removeAttribute('disabled');
          setTimeout(() => {
            statusMsg.className = 'hidden p-3 rounded-lg bg-black text-white text-center font-bold text-xs border border-black';
          }, 6000);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContactForm);
  } else {
    setupContactForm();
  }
</script>
