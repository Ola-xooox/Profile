---
// SchemaCard.astro - White Background Database Schema Card with Cursor Spotlight
interface Props {
  tableName: string;
  categoryName: string;
  primaryKey?: string;
  items: Array<{ name: string; type: string; vcHash?: string; verifiedAt?: string }>;
  class?: string;
}

const { tableName, categoryName, primaryKey = "id_did_pk", items, class: className = "" } = Astro.props;
---

<div class={`glass-panel-interactive rounded-xl p-5 border border-neutral-300 bg-white/90 shadow-md ${className}`} data-schema-card>
  <!-- Card Header -->
  <div class="flex items-center justify-between pb-3 mb-4 border-b border-neutral-200">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-black animate-pulse"></span>
      <h3 class="font-mono text-sm font-black text-black tracking-wide">{tableName}</h3>
    </div>
    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-black text-white uppercase tracking-widest font-bold">
      {categoryName}
    </span>
  </div>

  <!-- ID Row -->
  <div class="flex items-center justify-between px-3 py-1.5 mb-3 rounded bg-neutral-100 border border-neutral-300 font-mono text-xs">
    <span class="text-black font-bold">{primaryKey}</span>
    <span class="text-[11px] text-neutral-500 font-medium">ID</span>
  </div>

  <!-- Database Schema Field List -->
  <div class="space-y-2">
    {items.map((item, idx) => (
      <div class="flex items-center justify-between p-2 rounded bg-neutral-50 border border-neutral-200 hover:border-black hover:bg-neutral-100 transition-all duration-200 group">
        <div class="flex items-center gap-2 overflow-hidden">
          <span class="text-[10px] font-mono text-neutral-500 group-hover:text-black font-bold">0{idx + 1}</span>
          <span class="font-mono text-xs font-bold text-neutral-900 group-hover:text-black truncate">{item.name}</span>
        </div>

        <div class="flex items-center gap-2 flex-shrink-0">
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white text-black border border-neutral-300 font-bold group-hover:border-black">
            {item.type}
          </span>
          {item.vcHash && (
            <span 
              class="hidden sm:inline-block text-[9px] font-mono text-black bg-neutral-200 px-1.5 py-0.5 rounded border border-neutral-300 font-medium cursor-help transition-all"
              title={`Verifiable Credential Hash: ${item.vcHash} (Verified ${item.verifiedAt})`}
            >
              VC: {item.vcHash}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- Footer -->
  <div class="mt-4 pt-3 border-t border-neutral-200 flex items-center justify-between text-[11px] font-mono text-neutral-600">
    <span class="flex items-center gap-1 text-black font-bold">
      <svg class="w-3.5 h-3.5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
      </svg>
      Verified
    </span>
    <span class="font-bold">{items.length} skills</span>
  </div>
</div>

<script>
  function setupSpotlightEffect() {
    const cards = document.querySelectorAll('[data-schema-card]');
    cards.forEach((card) => {
      const element = card as HTMLElement;
      element.addEventListener('mousemove', (e) => {
        const rect = element.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        element.style.setProperty('--mx', `${x}px`);
        element.style.setProperty('--my', `${y}px`);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSpotlightEffect);
  } else {
    setupSpotlightEffect();
  }
</script>
